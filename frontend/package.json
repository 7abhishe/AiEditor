{
    "name": "codegenie-editor",
    "private": true,
    "version": "0.1.0",
    "description": "CodeGenie AI Editor — AI-powered code editor",
    "author": "CodeGenie Team",
    "repository": {
        "type": "git",
        "url": "https://github.com/7abhishe/AiEditor.git"
    },
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:build": "vite build && electron-builder",
        "cap:sync": "vite build && npx cap sync",
        "cap:ios": "npx cap open ios",
        "cap:android": "npx cap open android"
    },
    "build": {
        "appId": "com.codegenie.editor",
        "productName": "CodeGenie",
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "mac": {
            "target": "dmg",
            "icon": "public/icon.png",
            "category": "public.app-category.developer-tools"
        },
        "win": {
            "target": "nsis",
            "icon": "public/icon.png"
        },
        "linux": {
            "target": "AppImage",
            "icon": "public/icon.png",
            "category": "Development"
        },
        "directories": {
            "output": "release"
        },
        "publish": null
    },
    "dependencies": {
        "@capacitor/android": "^8.2.0",
        "@capacitor/cli": "^8.2.0",
        "@capacitor/core": "^8.2.0",
        "@capacitor/ios": "^8.2.0",
        "@capacitor/keyboard": "^8.0.1",
        "@capacitor/status-bar": "^8.0.1",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.11",
        "@codemirror/lang-java": "^6.0.2",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/lang-python": "^6.2.1",
        "@monaco-editor/react": "^4.7.0",
        "@uiw/react-codemirror": "^4.25.8",
        "dompurify": "^3.3.2",
        "lucide-react": "^0.469.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-markdown": "^9.0.3",
        "react-split-pane": "^0.1.92",
        "react-syntax-highlighter": "^15.6.1"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.0.0",
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0",
        "vite": "^6.0.0",
        "wait-on": "^8.0.0"
    }
}
