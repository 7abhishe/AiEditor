# ===========================
# CodeGenie AI Editor — Environment Variables Template
# ===========================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to Git!
# ===========================

# ── Google Gemini ─────────────────────────────────────
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-flash-preview

# ── Database ──────────────────────────────────────────
# Development (SQLite — zero config):
DATABASE_URL=sqlite+aiosqlite:///./codegenie.db

# Production (PostgreSQL — set on Render/AWS):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/codegenie

# ── JWT Authentication ────────────────────────────────
# ⚠️  CHANGE THIS in production! Generate with: openssl rand -hex 32
JWT_SECRET_KEY=codegenie-jwt-secret-change-in-production

# ── API Key (Legacy) ─────────────────────────────────
MASTER_API_KEY=codegenie-master-key-change-me

# ── Redis (Optional — for future session caching) ────
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Debug Mode ────────────────────────────────────────
# true  = Swagger UI enabled at /docs, verbose logging
# false = Swagger hidden, production-safe error messages
DEBUG=true
